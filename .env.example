# Скопируйте в .env и при необходимости измените. Все значения имеют безопасные для демо значения по умолчанию.

# Публичный адрес приложения (для редиректов OIDC и ссылок в письмах)
PUBLIC_URL=http://localhost:8080
# Публичный адрес ФСП ID (issuer). Для реального Keycloak ФСП: https://<keycloak-host>/realms/<realm>
FSP_PUBLIC_ISSUER=http://localhost:8090/realms/fsp

# Секреты (обязательно смените для продуктива)
SECRET_KEY=change-me-in-production-0123456789abcdef
POSTGRES_PASSWORD=fsp_dev_password
FSP_CLIENT_SECRET=fsp-career-secret
FSP_REGISTRY_API_KEY=registry-demo-key

# Демо-режим: код подтверждения e-mail возвращается в ответе API и показывается в интерфейсе
EMAIL_DEV_MODE=true
# «Попробовать как кандидат»: демо-аккаунт без регистрации в один клик (для жюри); в продуктиве — false
GUEST_MODE=true
# Наполнение демо-данными при первом старте (пустая БД)
SEED_DEMO=true
SEED_CANDIDATES=700
# Песочница для задач с кодом: токен доступа бэкенда к изолированному контейнеру sandbox
SANDBOX_TOKEN=sandbox-demo-token
# Черновики заданий от LLM (админка → «Черновики от LLM»): любой OpenAI-совместимый API. По умолчанию — Ollama на
# хосте (ollama pull qwen3:14b); пустое значение или недоступный сервис — демо-режим с заранее сгенерированными
# черновиками. Модели передаются только раздел теста, уровень и тема — без персональных данных.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen3:14b
LLM_API_KEY=
